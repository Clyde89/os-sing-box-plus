#!/bin/sh

# PROVIDE: sing_box
# REQUIRE: NETWORKING
# KEYWORD: shutdown

# shellcheck disable=SC1091
. /etc/rc.subr

name="sing_box"
# shellcheck disable=SC2034
rcvar="sing_box_enable"

pidfile="/var/run/sing-box.pid"
logdir="/var/log/sing-box"
logfile="${logdir}/sing-box.log"
command="/usr/local/bin/sing-box"
config="/usr/local/etc/sing-box/config.json"
pending_filter_reload="/var/db/os-sing-box/filter-reload.pending"
setup_required="/var/db/os-sing-box/setup-required"

# shellcheck disable=SC2034
start_cmd="${name}_start"
# shellcheck disable=SC2034
stop_cmd="${name}_stop"
# shellcheck disable=SC2034
status_cmd="${name}_status"

load_rc_config $name
: "${sing_box_enable:=no}"

read_pid() {
    [ -f "$pidfile" ] || return 1
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac
    printf '%s\n' "$pid"
}

process_is_sing_box() {
    pid="$1"
    kill -0 "$pid" 2>/dev/null || return 1

    proc_comm="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
    case "$proc_comm" in
        sing-box|*/sing-box)
            return 0
            ;;
    esac

    return 1
}

wait_for_exit() {
    pid="$1"
    timeout="${2:-10}"

    while [ "$timeout" -gt 0 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 1
        timeout=$((timeout - 1))
    done

    return 1
}

ensure_log_path() {
    install -d -o root -g wheel -m 750 "$logdir" || return 1
    touch "$logfile" || return 1
    chown root:wheel "$logfile" || return 1
    chmod 640 "$logfile" || return 1
}

remove_stale_pidfile() {
    [ -f "$pidfile" ] || return 0
    rm -f "$pidfile"
}

cleanup_failed_start() {
    pid="$1"

    if process_is_sing_box "$pid"; then
        kill "$pid" 2>/dev/null || true
        if ! wait_for_exit "$pid" 5; then
            kill -KILL "$pid" 2>/dev/null || true
            wait_for_exit "$pid" 2 || true
        fi
    fi

    remove_stale_pidfile
}

apply_pending_filter_reload() {
    [ -f "$pending_filter_reload" ] || return 0

    if ! command -v configctl >/dev/null 2>&1; then
        echo "Не удалось применить отложенные правила firewall: configctl недоступен."
        return 1
    fi

    echo "Применяются отложенные правила firewall после legacy-миграции..."
    if ! configctl filter reload >/dev/null 2>&1; then
        echo "Не удалось применить отложенные правила firewall."
        return 1
    fi

    rm -f "$pending_filter_reload"
    rmdir "$(dirname "$pending_filter_reload")" 2>/dev/null || true
    echo "Отложенные правила firewall применены."
    return 0
}

sing_box_start() {
    echo "Запуск sing-box..."

    if [ -f "$setup_required" ]; then
        echo "Запуск sing-box отклонён: первоначальная настройка не завершена."
        return 1
    fi

    if ! ensure_log_path; then
        echo "Не удалось подготовить файл журнала: $logfile"
        return 1
    fi

    if [ -f "$pidfile" ]; then
        existing_pid="$(read_pid || true)"
        if [ -n "$existing_pid" ] && process_is_sing_box "$existing_pid"; then
            if ! ifconfig tun_singbox >/dev/null 2>&1; then
                echo "Процесс sing-box уже запущен, но интерфейс tun_singbox отсутствует."
                return 1
            fi
            if ! apply_pending_filter_reload; then
                echo "Служба sing-box запущена, но отложенные правила firewall не применены."
                return 1
            fi
            echo "Служба sing-box уже запущена, PID $existing_pid."
            return 0
        fi

        if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
            echo "Устаревший PID-файл указывал на другой процесс; PID-файл удалён."
        else
            echo "Устаревший PID-файл удалён."
        fi
        remove_stale_pidfile
    fi

    if service mihomo status >/dev/null 2>&1; then
        echo "Запуск sing-box отклонён: mihomo уже использует прозрачную маршрутизацию."
        return 1
    fi

    if [ ! -x "$command" ] || [ ! -f "$config" ]; then
        echo "Исполняемый файл sing-box или рабочая конфигурация отсутствуют."
        return 1
    fi

    if ! "$command" check -c "$config" >> "$logfile" 2>&1; then
        echo "Конфигурация sing-box не прошла проверку."
        return 1
    fi

    nohup "$command" run -c "$config" >> "$logfile" 2>&1 &
    started_pid=$!
    printf '%s\n' "$started_pid" > "$pidfile"
    chmod 0600 "$pidfile"

    sleep 1
    if ! process_is_sing_box "$started_pid"; then
        echo "Процесс sing-box завершился во время запуска."
        cleanup_failed_start "$started_pid"
        return 1
    fi

    timeout=20
    while [ "$timeout" -gt 0 ]; do
        if ifconfig tun_singbox >/dev/null 2>&1; then
            break
        fi
        if ! process_is_sing_box "$started_pid"; then
            echo "Процесс sing-box завершился до создания tun_singbox."
            cleanup_failed_start "$started_pid"
            return 1
        fi
        sleep 1
        timeout=$((timeout - 1))
    done

    if ! ifconfig tun_singbox >/dev/null 2>&1; then
        echo "Интерфейс tun_singbox не был создан за 20 секунд; запуск отменён."
        cleanup_failed_start "$started_pid"
        return 1
    fi

    if ! apply_pending_filter_reload; then
        echo "Запуск sing-box отменён: отложенные правила firewall не применены."
        cleanup_failed_start "$started_pid"
        return 1
    fi

    echo "Служба запущена, PID $started_pid."
}

sing_box_stop() {
    echo "Остановка sing-box..."

    if [ ! -f "$pidfile" ]; then
        echo "Служба sing-box не запущена: PID-файл отсутствует."
        return 0
    fi

    pid="$(read_pid || true)"
    if [ -z "$pid" ]; then
        echo "Некорректный PID-файл удалён."
        remove_stale_pidfile
        return 0
    fi

    if ! kill -0 "$pid" 2>/dev/null; then
        echo "Устаревший PID-файл удалён."
        remove_stale_pidfile
        return 0
    fi

    if ! process_is_sing_box "$pid"; then
        proc_comm="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
        echo "PID-файл указывал на другой процесс и был удалён: $pid (${proc_comm:-неизвестно})."
        remove_stale_pidfile
        return 0
    fi

    if kill "$pid" && wait_for_exit "$pid" 10; then
        remove_stale_pidfile
        echo "Служба остановлена."
        return 0
    fi

    echo "Превышено время ожидания остановки sing-box."
    return 1
}

sing_box_status() {
    if [ ! -f "$pidfile" ]; then
        echo "Служба sing-box не запущена."
        return 1
    fi

    pid="$(read_pid || true)"
    if [ -z "$pid" ]; then
        echo "PID-файл sing-box некорректен."
        return 1
    fi

    if process_is_sing_box "$pid"; then
        if ! ifconfig tun_singbox >/dev/null 2>&1; then
            echo "Процесс sing-box работает, но интерфейс tun_singbox отсутствует."
            return 1
        fi
        echo "Служба sing-box работает, PID $pid."
        return 0
    fi

    if kill -0 "$pid" 2>/dev/null; then
        proc_comm="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
        echo "PID-файл sing-box указывает на другой процесс: $pid (${proc_comm:-неизвестно})."
    else
        echo "PID-файл найден, но процесс sing-box не работает."
    fi
    return 1
}

run_rc_command "$1"
