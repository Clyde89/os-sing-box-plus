#!/bin/sh

# PROVIDE: sing_box
# REQUIRE: NETWORKING
# KEYWORD: shutdown

# shellcheck disable=SC1091
. /etc/rc.subr

name="sing_box"
# shellcheck disable=SC2034
rcvar="sing_box_enable"

pidfile="/var/run/sing-box.pid"
logdir="/var/log/sing-box"
logfile="${logdir}/sing-box.log"
command="/usr/local/bin/sing-box"
config="/usr/local/etc/sing-box/config.json"

# shellcheck disable=SC2034
start_cmd="${name}_start"
# shellcheck disable=SC2034
stop_cmd="${name}_stop"
# shellcheck disable=SC2034
status_cmd="${name}_status"

load_rc_config $name
: "${sing_box_enable:=no}"

wait_for_exit() {
    pid="$1"
    timeout="${2:-10}"

    while [ "$timeout" -gt 0 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 1
        timeout=$((timeout - 1))
    done

    return 1
}

ensure_log_path() {
    install -d -o root -g wheel -m 750 "$logdir" || return 1
    touch "$logfile" || return 1
    chown root:wheel "$logfile" || return 1
    chmod 640 "$logfile" || return 1
}

sing_box_start() {
    echo "Запуск sing-box..."

    if ! ensure_log_path; then
        echo "Не удалось подготовить файл журнала: $logfile"
        return 1
    fi

    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo "Служба sing-box уже запущена."
        return 1
    fi

    if service mihomo status >/dev/null 2>&1; then
        echo "Запуск sing-box отклонён: mihomo уже использует прозрачную маршрутизацию."
        return 1
    fi

    if [ ! -x "$command" ] || [ ! -f "$config" ]; then
        echo "Исполняемый файл sing-box или рабочая конфигурация отсутствуют."
        return 1
    fi

    if ! "$command" check -c "$config" >> "$logfile" 2>&1; then
        echo "Конфигурация sing-box не прошла проверку."
        return 1
    fi

    nohup "$command" run -c "$config" >> "$logfile" 2>&1 &
    echo $! > "$pidfile"
    sleep 1
    if ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo "Процесс sing-box завершился во время запуска."
        rm -f "$pidfile"
        return 1
    fi

    timeout=20
    while [ "$timeout" -gt 0 ]; do
        if ifconfig tun_singbox >/dev/null 2>&1; then
            break
        fi
        if ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
            echo "Процесс sing-box завершился до создания tun_singbox."
            rm -f "$pidfile"
            return 1
        fi
        sleep 1
        timeout=$((timeout - 1))
    done

    if ! ifconfig tun_singbox >/dev/null 2>&1; then
        echo "Интерфейс tun_singbox не был создан за 20 секунд."
        return 1
    fi

    echo "Служба запущена, PID $(cat "$pidfile")."
}

sing_box_stop() {
    echo "Остановка sing-box..."

    if [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile")
        if kill -0 "$pid" 2>/dev/null; then
            proc_comm=$(ps -p "$pid" -o comm= 2>/dev/null)
            case "$proc_comm" in
                sing-box|*/sing-box)
                    if kill "$pid" && wait_for_exit "$pid" 10; then
                        rm -f "$pidfile"
                        echo "Служба остановлена."
                    else
                        echo "Превышено время ожидания остановки sing-box."
                        return 1
                    fi
                    ;;
                *)
                    echo "PID-файл указывает на другой процесс: $pid ($proc_comm)."
                    return 1
                    ;;
            esac
        else
            rm -f "$pidfile"
            echo "Устаревший PID-файл удалён."
        fi
    else
        echo "Служба sing-box не запущена: PID-файл отсутствует."
    fi
}

sing_box_status() {
    if [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Служба sing-box работает, PID $pid."
            return 0
        fi

        echo "PID-файл найден, но процесс sing-box не работает."
        return 1
    fi

    echo "Служба sing-box не запущена."
    return 1
}

run_rc_command "$1"
