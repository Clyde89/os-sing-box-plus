#!/bin/sh

SING_BOX_DIR="/usr/local/etc/sing-box"
SING_BOX_CONFIG="${SING_BOX_DIR}/config.json"
SING_BOX_SAMPLE="${SING_BOX_DIR}/config.json.sample"
SING_BOX_LOG_DIR="/var/log/sing-box"
SING_BOX_LOG="${SING_BOX_LOG_DIR}/sing-box.log"
RC_CONF_FILE="/etc/rc.conf.d/sing_box"

echo "===> Настраивается os-sing-box"

mkdir -p /etc/rc.conf.d
if [ ! -f "$RC_CONF_FILE" ]; then
    echo 'sing_box_enable="YES"' > "$RC_CONF_FILE"
fi

install -d -o root -g wheel -m 0750 "$SING_BOX_LOG_DIR"
touch "$SING_BOX_LOG"
chown root:wheel "$SING_BOX_LOG"
chmod 0640 "$SING_BOX_LOG"

if [ ! -f "$SING_BOX_CONFIG" ] && [ -f "$SING_BOX_SAMPLE" ]; then
    install -o root -g wheel -m 0600 "$SING_BOX_SAMPLE" "$SING_BOX_CONFIG"
fi

rm -f /usr/local/www/services_sing_box.php /usr/local/www/status_sing_box.php
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json
rm -rf /usr/local/opnsense/mvc/app/models/OPNsense/sing-box

service configd restart >/dev/null 2>&1 || true

if grep -q 'sing_box_enable="YES"' "$RC_CONF_FILE" 2>/dev/null; then
    service sing-box restart >/dev/null 2>&1 || true
fi
